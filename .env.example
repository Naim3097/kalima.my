# Public origin, used to build absolute redirect URLs in OAuth callbacks.
# Falls back to http://localhost:3000 when unset, which is wrong in production —
# a callback would redirect the merchant to localhost mid-connection.
NEXT_PUBLIC_APP_URL=https://www.kalima.my

# Closes the storefront to the public: every page returns a 503 maintenance
# notice instead. Set it to exactly "on" (any other value, including unset,
# means open) and set it on the PRODUCTION environment only — staging then
# stays fully browsable, which is the point of the switch.
#
# Signed-in staff pass straight through and see the real site. Webhooks, the
# sync cron and the login/auth routes stay reachable so money and fulfilment
# in flight are not dropped; see OPEN_DURING_MAINTENANCE in src/lib/maintenance.ts.
#
# Vercel reads env vars at build time, so flipping this needs a redeploy to
# take effect.
MAINTENANCE_MODE=

# Supabase — Project Settings > API (see supabase/README.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Required from Phase 2: order creation, the payment
# webhook and order lookup all run through it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend). Order/payment emails no-op until this is set.
RESEND_API_KEY=
# From-address for transactional mail, e.g. "Kalima <orders@kalima.my>".
# MUST be on a domain verified in Resend. A free mailbox (@gmail.com, @yahoo.com)
# cannot be used here — sending requires publishing DKIM/SPF records in that
# domain's DNS, which you cannot do for someone else's domain.
RESEND_FROM=
# Optional. Where customer replies land, when that is not the From address —
# e.g. a Gmail inbox support already watches. Replies need no DNS proof.
RESEND_REPLY_TO=

# Public origin of the live site, e.g. https://kalima.my — no trailing slash.
# The payment callback URL is built from this. Leave blank and it falls back to
# the request's own host, which on a deployment-specific Vercel URL behind
# Deployment Protection means the gateway's callback hits the SSO wall: no
# request reaches us, nothing appears in the logs, and paid orders stay pending.
# Set it in production.
NEXT_PUBLIC_SITE_URL=

# Payment gateway — LeanX (FPX + e-wallets). Checkout falls back to
# "order received, payment pending" until AUTH_TOKEN + COLLECTION_UUID are set.
# Host MUST be .io — .dev is legacy and unstable.
LEANX_API_HOST=https://api.leanx.io
LEANX_AUTH_TOKEN=
LEANX_COLLECTION_UUID=
# The collection's "Hash Key". Verifies both callback envelopes (the HS256 JWT
# and the x-leanx-signature HMAC). Without it the webhook fails closed (401) —
# an order can never be marked paid. It is PER COLLECTION: change the
# collection and this must change too, or bills create fine and every callback
# 401s while customers are charged.
LEANX_WEBHOOK_SECRET=

# Payment gateway — Atome (buy now, pay later; 3 interest-free instalments).
# A SECOND provider alongside LeanX, not a replacement: Atome appears as its own
# group on /checkout/pay and is hidden on orders under RM10, its documented
# MYR minimum. Username and password are issued by your Atome account manager.
ATOME_USERNAME=
ATOME_PASSWORD=
ATOME_COUNTRY_CODE=MY
# Sandbox (api.apaylater.net) unless this is exactly "production", which selects
# api.apaylater.com. Deliberately opt-in: an unset value cannot take real money.
ATOME_ENV=test
# HMAC-SHA256 secret for the X-Signature header on Atome's callback. OPTIONAL,
# unlike LeanX's — Atome's callback carries only a referenceId, so the adapter
# always re-reads the payment from Atome over authenticated HTTPS and a forged
# callback cannot mark an order paid. Set it when your account manager supplies
# the signing details; /api/payments/health warns while it is missing.
ATOME_CALLBACK_SECRET=

# Staging Supabase project (local + Vercel Preview). Local development points at
# STAGING so an edit here can never desynchronise production's cache — see the
# Environments section of README.md. Production keeps the Kalima project.
# The two STAGING_* names below are only needed by scripts/copy-catalogue.mjs,
# which refreshes staging from production; remove them once it has run.
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Second storage host allowed for next/image. Staging's catalogue is copied from
# production, so product_images.url still points at production's public bucket.
# Preview only; unset in production, where the derived host already covers it.
NEXT_PUBLIC_LEGACY_IMAGE_HOST=

# EasyParcel (Phase 4 shipping). OAuth credentials issued by EasyParcel.
# REDIRECT_URI must match what is registered with them, exactly.
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
EASYPARCEL_REDIRECT_URI=https://www.kalima.my/api/shipping/callback
# Shared secret for inbound status webhooks. The endpoint FAILS CLOSED without it.
EASYPARCEL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Marketplace + messaging channels (Phases 8 and 9).
#
# NONE of these are wired yet — every platform is awaiting app approval, and
# their adapters in src/lib/channels/ are stubs until credentials and a sandbox
# exist to build against. Setting the variables alone does NOT enable a channel;
# the admin surface will say so explicitly rather than pretending otherwise.
# ---------------------------------------------------------------------------

# Drives the sync worker at /api/channels/sync, called by the Vercel cron in
# vercel.json. Vercel presents it as `Authorization: Bearer $CRON_SECRET`.
# The endpoint FAILS CLOSED: with this unset, cron callers are rejected and only
# a signed-in staff member can trigger a drain. The schedule is daily because
# Hobby allows one cron run per day; a sub-daily expression fails the build.
CRON_SECRET=

# Shopee Open Platform (Phase 8 stock sync + Phase 9 chat).
# REDIRECT_URI must match what is registered in the Open Platform console.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://www.kalima.my/api/channels/shopee/callback

# TikTok Shop Partner Center (Phase 8) + Business Messaging (Phase 9).
# One merchant authorization covers both surfaces.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://www.kalima.my/api/channels/tiktok/callback

# Meta — WhatsApp Cloud API, Instagram DM and Facebook Page messages (Phase 9).
# ONE app and ONE Business verification serves all three, and the same
# verification unblocks the Phase 5 WhatsApp broadcast.
META_APP_ID=
# Also the webhook signing key: Meta HMACs the raw body with it (x-hub-signature-256).
META_APP_SECRET=
META_REDIRECT_URI=https://www.kalima.my/api/channels/whatsapp/callback
# A string YOU invent (openssl rand -hex 24) and paste into the Meta dashboard.
# Meta echoes it back during the webhook handshake; the adapter compares and
# returns hub.challenge as raw text. Unset, the handshake is refused.
META_VERIFY_TOKEN=
# The WhatsApp sending number's id, from the app dashboard.
META_WHATSAPP_PHONE_ID=
# Permanent System User access token. WhatsApp Cloud API for a single business
# uses no OAuth round trip, so this IS the credential — it stays here and is
# never written to the database. All four META_* values above must be set for
# the WhatsApp adapter to report itself configured.
META_WHATSAPP_TOKEN=

# Instagram DM + Facebook Page messages. Same app, same APP_SECRET, same
# VERIFY_TOKEN — only the ids and the sending token are new.
#
# The Facebook Page's numeric id. BOTH channels send through it — an Instagram
# professional account is reached via the Page it is linked to, and the
# recipient id decides which surface the message lands on.
META_PAGE_ID=
# The Instagram PROFESSIONAL ACCOUNT id — not the @handle, and not the Page id.
# Identity only: it is what the connect check verifies and the admin card shows.
# Sending to {META_INSTAGRAM_ID}/messages fails with a misleading
# "(#3) Application does not have the capability to make this API call".
META_INSTAGRAM_ID=
# One Page access token serves both surfaces: an Instagram professional account
# is addressed through the Page it is linked to, so there is no separate
# Instagram token. Generate it for the same System User that holds the WhatsApp
# token, with `pages_messaging` + `instagram_business_manage_messages` and the
# Page assigned as an asset.
#
# Setting these makes the adapters report configured, which is correct — they
# work under Standard Access against accounts holding a role on the app. Meta
# App Review is what lets them message the PUBLIC, and it requires a screencast
# of the working feature, so the credentials come first. See INSTRUCTION.md §3.1.
META_PAGE_TOKEN=
#
# Set these on the PRODUCTION environment: Meta takes one callback URL per
# product, and www.kalima.my is the one that survives launch. Staging shares the
# same Supabase project, so messages delivered to production still appear in
# staging's /admin/inbox. Add them to Preview too only if you want to SEND from
# staging — sending is an outbound call and does not depend on the callback URL.
#
# Read at module load, so adding them needs a redeploy to take effect.
