# Supabase — Project Settings > API (see supabase/README.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Required from Phase 2: order creation, the payment
# webhook and order lookup all run through it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend). Order/payment emails no-op until this is set.
RESEND_API_KEY=
# From-address for transactional mail, e.g. "Kalima <orders@kalima.my>"
RESEND_FROM=

# Payment gateway (LeanX) — added when the integration .md lands.
# LEANX_...=
